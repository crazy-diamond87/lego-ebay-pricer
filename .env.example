# ─────────────────────────────────────────────────────────────
# eBay Developer API credentials
# Get yours at: https://developer.ebay.com/my/keys
# ─────────────────────────────────────────────────────────────

EBAY_APP_ID=YourAppName-YourApp-PRD-xxxxxxxxxxxx-xxxxxxxx
EBAY_DEV_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EBAY_CERT_ID=PRD-xxxxxxxxxxxx-xxxx-xxxx-xxxx-xxxx

# eBay user token — generate via the Auth'n'Auth flow in the Developer Portal
EBAY_USER_TOKEN=v^1.1#i^1#...your_token_here...

# ─────────────────────────────────────────────────────────────
# Listing configuration
# ─────────────────────────────────────────────────────────────

# Your seller postal code (used for shipping origin)
EBAY_POSTAL_CODE=10115

# eBay site ID: 77 = eBay.de  |  0 = eBay.com  |  3 = eBay.co.uk
EBAY_SITE_ID=77

# Handling time in business days
EBAY_DISPATCH_TIME=1

# Stock quantity per listing
EBAY_QUANTITY=10

# ─────────────────────────────────────────────────────────────
# Image API keys (used by image_fetcher.py)
# ─────────────────────────────────────────────────────────────

# Free key at: https://rebrickable.com/api/
REBRICKABLE_API_KEY=your_rebrickable_key_here

# Free key at: https://brickset.com/tools/webservices/requestkey
# Optional — without it only the Rebrickable hero image is fetched
BRICKSET_API_KEY=your_brickset_key_here
